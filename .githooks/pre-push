#!/usr/bin/env bash
# Runs the fast checks before every push, so broken code is caught locally
# instead of minutes later in CI.
#
# Enable once per clone:  git config core.hooksPath .githooks
# Skip in an emergency:   git push --no-verify
set -euo pipefail

cd "$(git rev-parse --show-toplevel)/go-services"

echo "pre-push: gofmt"
unformatted=$(gofmt -l .)
if [ -n "$unformatted" ]; then
  echo "These files are not gofmt'ed:"
  echo "$unformatted"
  exit 1
fi

echo "pre-push: go vet"
go vet ./...

echo "pre-push: go test"
go test -race ./...

echo "pre-push: all checks passed"
