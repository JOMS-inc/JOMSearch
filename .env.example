# Copy this file to .env and fill in real values. Never commit .env.

# Key used to sign session cookies. Generate one with: openssl rand -hex 32
SESSION_SECRET=change-me

# PostgreSQL connection URL. In production: Neon's *direct* (not "pooled")
# connection string, see database.md. connect_timeout gives Neon time to wake
# up after it scaled to zero.
DATABASE_URL=postgres://user:password@host/jomsearch?sslmode=require&connect_timeout=15

# Contact (URL or email) sent in the crawler's User-Agent. Wikipedia's bot
# policy asks for one so they can reach you instead of blocking the crawler.
CRAWLER_CONTACT=
